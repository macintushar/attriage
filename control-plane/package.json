{
  "name": "control-plane",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "seed": "node --env-file=../.env --import tsx scripts/seed.ts",
    "try-turn": "node --env-file=../.env --import tsx scripts/try-turn.ts",
    "mock-llm": "bun scripts/mock-llm.ts",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "node scripts/gen-auth-schema.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "1.6.25",
    "@chat-adapter/state-memory": "^4.35.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@tabler/icons-react": "^3.45.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "baileys": "^7.0.0-rc13",
    "better-auth": "^1.6.25",
    "chat": "^4.35.0",
    "chat-adapter-baileys": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9",
    "jsdom": "^28",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tsx": "^4.20.6",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
