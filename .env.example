# Copy to .env and fill in. The control-plane scripts load it from the repo root.

# Sarvam — https://dashboard.sarvam.ai (the key is shown once, at creation)
SARVAM_API_KEY=

# Better Auth — generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# TanStack Start backend state
DATA_DIR=./data
SANDBOX_IMAGE=sarvam-sandbox:latest
AGENT_MODEL=sarvam-105b

# Containers idle longer than this are reaped (the workdir survives).
SESSION_IDLE_MS=900000
# Hard ceiling on one agent turn.
TURN_TIMEOUT_MS=240000

# Per-connector secrets. Add one var per credential field your agents use and
# reference it by NAME in the agent's connector config — the backend forwards
# the value into the sandbox at `docker run` time and pm reads it via
# `--from-env`. Never put secret values in an agent's config or system prompt.
# ACME_HEALTH_API_KEY=
